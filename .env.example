# --- Base Configuration ---
# Use 'id' command to find your UID and GID
PUID=1000
PGID=1000

# Path to your media storage
MEDIA_DIRECTORY=/srv/media

# --- Networking ---
# Tailscale Auth Key
# Get one at: https://login.tailscale.com/admin/settings/keys
# Regenerate every 90 days (it expires after 90 days)
TAILSCALE_AUTH_KEY=tskey-auth-your-key-here

# Your Tailscale network domain (e.g. your-name.ts.net)
TS_DOMAIN=your-tailnet-domain.ts.net

# Your server's local IP address
LOCAL_IP=192.168.1.100

# --- Homepage Dashboard ---
# List of allowed hostnames for the dashboard (comma-separated)
HOMEPAGE_ALLOWED_HOSTS=localhost,127.0.0.1,${LOCAL_IP},media.${TS_DOMAIN}

# --- AI Integration (Mealie/Optional) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-api-key-here

# --- VPN Configuration ---
# Your VPN subscription URL (e.g. VLESS subscription link)
VPN_SUB_URL=https://your-subscription-url.example.com
# Exclude nodes containing any of these substrings (comma separated)
VPN_EXCLUDE_NODE_TAGS="Russia,🇷🇺,RU ,China,🇨🇳,CN "
# Config update interval in seconds (default 3600 = 1 hour)
VPN_UPDATE_INTERVAL=3600
